<h1>Messages</h1>
<table>
  <thead>
    <tr><th>Created</th><th>Sender</th><th>Message</th><th>Nonce</th></tr>
  </thead>
  <tbody>
    <% @messages.each do |m| %>
      <tr>
        <td><%= m.created_at&.strftime("%Y-%m-%d %H:%M:%S") %></td>
        <td><%= m.sender_tag %></td>
        <td><%= link_to m.message.truncate(80), message_path(m) %></td>
        <td><%= m.nonce %></td>
      </tr>
    <% end %>
  </tbody>
</table>
